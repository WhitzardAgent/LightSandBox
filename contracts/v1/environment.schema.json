        "properties": {
          "image": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "minLength": 1
          },
          "launch_mode": {
            "enum": [
              "image",
              "idle-agent"
            ],
            "default": "image"
          },
          "entrypoint": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            },
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^[^\\u0000]*$",
                "minLength": 1
              }
            ]
          },
          "command": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            },
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^[^\\u0000]*$",
                "minLength": 1
              }
            ]
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^=\\u0000]+$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            }
          },
          "cwd": {
            "type": "string",
            "pattern": "^/[^\\u0000]*$"
          },
          "user": {
            "type": "string",
            "pattern": "^[^\\u0000]*$",
            "minLength": 1
          },
          "resources": {
            "type": "object",
            "properties": {
              "cpu_millis": {
                "type": "integer",
                "minimum": 1
              },
              "memory_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "storage_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "pids": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "mounts": {
            "oneOf": [
              {
                "type": "array",
                "maxItems": 0
