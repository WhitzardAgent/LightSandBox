              {
                "type": "object",
                "maxProperties": 0
              }
            ]
          },
          "networks": {
            "oneOf": [
              {
                "type": "array",
                "maxItems": 0
              },
              {
                "type": "object",
                "maxProperties": 0
              }
            ]
          },
          "depends_on": {
            "oneOf": [
              {
                "type": "array",
                "maxItems": 0
              },
              {
                "type": "object",
                "maxProperties": 0
              }
            ]
          }
        },
        "required": [
          "image"
        ],
        "additionalProperties": false
      }
    },
    "networks": {
      "type": "object",
      "maxProperties": 0
    },
    "volumes": {
      "type": "object",
      "maxProperties": 0
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
